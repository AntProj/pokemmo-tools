# Copy this file to `.env.local` (gitignored) and fill in your local paths.
# Load into your shell before running map scripts.
#
# PowerShell:
#   Get-Content .env.local | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+)\s*=\s*"?(.*?)"?\s*$') {
#       Set-Item "env:$($matches[1].Trim())" $matches[2]
#     }
#   }
#
# Bash / WSL:
#   set -a; source .env.local; set +a

# ─── Map generator input ─────────────────────────────────────────────────
# Root of the Pokemmo Maps dump containing:
#   map_data/map/        — *.png renders (1:1 pixels per world unit)
#   map_data/data/       — sidecar *.json with worldBounds (one per PNG)
#   warps/               — per-zone warp JSONs
#   trainer_data/data/   — per-instance trainer JSONs
#   trainer_data/sprites/— overworld sprite PNGs
POKEMMO_MAPS_DIR=C:/path/to/your/Pokemmo Maps

# Optional: override the public image host (defaults to the project's
# Cloudflare R2 public URL). Set to empty for local-relative URLs.
# MAPS_IMAGE_HOST=https://your-cdn.example

# ─── Cloudflare R2 (upload script) ────────────────────────────────────────
# Required by `npm run upload:maps` and `npm run purge:r2`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pokemmo-maps
