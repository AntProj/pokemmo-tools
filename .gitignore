# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Generated data (rebuild with: npm run build:data). Lives in public/ so it's
# served as a static asset and fetched at runtime instead of bundled into JS.
public/data/pokemmo.json

# Map image WebPs — hosted on Cloudflare R2 instead of committed to the repo
# (the full image set is hundreds of MB per region; sprites are baked into the
# WebPs by build_world.py's composite step, so there's no separate sprite set).
# Same story for the overworld tile pyramid (`tiles/`): thousands of tiles per
# region, all pushed to R2.
# Regenerate locally with `npm run build:map-data:<region>`, then push to R2
# with `npm run upload:maps:<region>` (or use `regen-and-sync:<region>` for
# both in one shot).
public/data/maps/*/images/
public/data/maps/*/tiles/

# Temporary worktree used by scripts/deploy-gh-pages.mjs. The deploy script
# creates this dir, populates it with dist/ contents, pushes, then removes
# it. If a deploy is interrupted, the dir may persist — gitignored so it
# doesn't pollute `git status` on main.
.gh-pages-tmp/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
