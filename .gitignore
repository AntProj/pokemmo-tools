src/data/pokemmo.json

# Map image PNGs — hosted on Cloudflare R2 instead of committed to the repo
# (the full Sinnoh image set is hundreds of MB; sprites are baked into the
# PNGs by build_world.py's composite step, so there's no separate sprite set).
# Regenerate locally with `npm run build:map-data`, then push to R2 with
# `npm run upload:maps`.
public/data/maps/sinnoh/images/

