# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Generated data (rebuild with: npm run build:data)
src/data/pokemmo.json

# Map image WebPs — hosted on Cloudflare R2 instead of committed to the repo
# (the full image set is hundreds of MB per region; sprites are baked into the
# WebPs by build_world.py's composite step, so there's no separate sprite set).
# Same story for the overworld tile pyramid (`tiles/`): thousands of tiles per
# region, all pushed to R2.
# Regenerate locally with `npm run build:map-data:<region>`, then push to R2
# with `npm run upload:maps:<region>` (or use `regen-and-sync:<region>` for
# both in one shot).
public/data/maps/*/images/
public/data/maps/*/tiles/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
